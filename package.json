{
  "name": "browser",
  "version": "0.1.1",
  "private": true,
  "description": "Claude Browser",
  "author": "Raj Tiwari",
  "main": "main.js",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "electron:dev": "electron .",
    "pack:standalone": "npm run build && node scripts/prepare-standalone.js",
    "dist": "npm run pack:standalone && electron-builder",
    "release": "npm run pack:standalone && electron-builder --publish always"
  },
  "dependencies": {
    "@qdrant/js-client-rest": "^1.18.0",
    "@xenova/transformers": "^2.17.2",
    "electron-updater": "^6.6.2",
    "font-picker-react": "^3.5.2",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.25.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-colorful": "^5.8.0",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^43.1.1",
    "electron-builder": "^26.0.12",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.claude.browser",
    "productName": "Claude Browser",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "node_modules/**"
    ],
    "extraResources": [
      {
        "from": ".next",
        "filter": ["standalone/**"]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "sarfraj-dev11",
        "repo": "browser"
      }
    ]
  }
}
